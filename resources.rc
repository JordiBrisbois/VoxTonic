#ifndef VOXT_VERSION_MAJOR
#define VOXT_VERSION_MAJOR 0
#define VOXT_VERSION_MINOR 0
#define VOXT_VERSION_PATCH 0
#define VOXT_VERSION_BUILD 0
#endif

#define VOXT_STR_IMPL(x) #x
#define VOXT_STR(x) VOXT_STR_IMPL(x)
#define VOXT_VERSION_STR \
    VOXT_STR(VOXT_VERSION_MAJOR) "." VOXT_STR(VOXT_VERSION_MINOR) "." \
    VOXT_STR(VOXT_VERSION_PATCH) "." VOXT_STR(VOXT_VERSION_BUILD)

VS_VERSION_INFO VERSIONINFO
 FILEVERSION VOXT_VERSION_MAJOR,VOXT_VERSION_MINOR,VOXT_VERSION_PATCH,VOXT_VERSION_BUILD
 PRODUCTVERSION VOXT_VERSION_MAJOR,VOXT_VERSION_MINOR,VOXT_VERSION_PATCH,VOXT_VERSION_BUILD
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "VoxTonic"
            VALUE "FileDescription", "Guild Wars 2 cosmetic tonic auto re-press addon"
            VALUE "FileVersion", VOXT_VERSION_STR
            VALUE "InternalName", "VoxTonic"
            VALUE "OriginalFilename", "VoxTonic.dll"
            VALUE "ProductName", "VoxTonic"
            VALUE "ProductVersion", VOXT_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
